DATABASE_URL="file:./dev.db"

# AI provider: "mock" (default, no external calls) or "anthropic"
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY="sk-..." # only required if AI_PROVIDER=anthropic

# Storage provider: "local" (default) — writes under /data/uploads
STORAGE_PROVIDER="local"

# Auth provider: "dev" (default) — cookie session + role switcher, no real SSO
AUTH_PROVIDER="dev"
